# API de la plataforma web PAEGo (repo oPAEGo).
#   Producción (Azure):               https://azwafmsbgbksw4m22.azurewebsites.net
#   Alternativa (Railway):            https://web-production-9a3cf.up.railway.app
#   Emulador Android + runserver:      http://10.0.2.2:8000
#   Chrome / escritorio + runserver:   http://localhost:8000
PAEGO_API_URL=https://azwafmsbgbksw4m22.azurewebsites.net

# Mapa principal: Mapbox (recomendado). Token público "pk.…" de
#   https://console.mapbox.com  ->  Tokens  ->  Default public token
# Capa gratuita de la Static Tiles API: 200 000 teselas al mes. Sin token se
# usa ArcGIS (si hay clave) u OpenStreetMap.
MAPBOX_ACCESS_TOKEN=

# Mapas base de ArcGIS (opcional). Clave de ArcGIS Location Platform con el
# permiso "Basemap styles service / Static basemap tiles". Capa gratuita:
# 2 millones de teselas al mes. Sin clave, el mapa usa OpenStreetMap.
#   https://location.arcgis.com  ->  Developer credentials  ->  API key
ARCGIS_API_KEY=

SUPABASE_URL=https://bfeojjyvryzgbnmyivus.supabase.co
SUPABASE_ANON_KEY=sb_publishable_YQa6PXQkEBgyYK1m5SI4FA_5YUhAtlU
SUPABASE_APP_TEXTS_TABLE=app_texts

# Nutrición: el asistente lo atiende el backend (POST /api/nutricion/asistente/),
# que guarda la clave de Gemini (GEMINI_API_KEY en el .env de oPAEGo). La app no
# necesita ninguna clave: este .env se empaqueta dentro del APK.